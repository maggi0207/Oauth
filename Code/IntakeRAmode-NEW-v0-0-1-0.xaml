            <Page x:Name="IndvClearanceAE" Text="Individual Clearance" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/IndividualClearanceResults.aspx"/>
            <Page x:Name="MatchedDemoDetailSummaryAE" Text="Matched Individual Demographics" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/MatchedIndividualSummary.aspx"/>
            <Page x:Name="MatchedIndivDemoDetailsAE" Text="Matched Individual Details Details" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/MatchedIndividualDemographicsDetails.aspx"/>
            <Page x:Name="EstablishIndvAE" Text="Establish Individual" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/EstablishIndividual.aspx"/>
            <Page x:Name="EstablishIndvReviewAE" Text="Establish Individual" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/EstablishIndividualReview.aspx"/>
            <Page x:Name="FinalClearanceStatusAE" Text="Final Clearance" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/FinalClearanceStatus.aspx"/>
        </WorkflowRules>
