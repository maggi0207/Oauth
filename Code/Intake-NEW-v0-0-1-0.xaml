<!-- ClientRegitstation_Application -->
<WorkflowRules x:Name="Intake"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns="clr-namespace:Dhss.Framework.Web.UI.Workflow;assembly=Dhss.Framework.Web"
  xmlns:dhss="clr-namespace:Dhss.Framework.Web.UserControls;assembly=Dhss.Framework.Web.UserControls"
  xmlns:asp="clr-namespace:System.Web.UI.WebControls;assembly=System.Web"
  xmlns:n="clr-namespace:Dhss.Framework.Web.UI.Workflow.Markup;assembly=Dhss.Framework.Web">



	<WorkflowRules x:Name="ClientRegistrationTop" Text="Client Registration">
		<WorkflowRules x:Name="ClientRegistration" Text="Client Registration" Context="{n:DataSource Name='dsClientRegistration_RFA'}">
			<WorkflowRules.DataSources>
				<dhss:DataServiceLinqDataSource
            x:Key="dsClientRegistration_RFA"
            TableName="ClientRegistration_Application"
            EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ClientRegistration.ClientRegistration_RFA"
            ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.ClientRegistrationContextImpl"
           
            Where="ApplicationID = @ApplicationID">
					<dhss:DataServiceLinqDataSource.WhereParameters>
						<dhss:WorkflowParameter Property="ApplicationID" Name="ApplicationID" Source="StateKey" Type="Int32"/>
					</dhss:DataServiceLinqDataSource.WhereParameters>
				</dhss:DataServiceLinqDataSource>
				<dhss:DataServiceLinqDataSource
            x:Key="dsClientRegistration_Persons"
            TableName="ClientRegistration_Entity"
            EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ClientRegistration.ClientRegistration_Person"
            ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.ClientRegistrationContextImpl"
            Selecting="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='ClientRegistrationPerson_Selecting'}">
				</dhss:DataServiceLinqDataSource>
			</WorkflowRules.DataSources>
			<Page x:Name="RFAInfo" Text="RFA Information" NavigateUrl="~/Intake/ClientRegistration/RFAInformation.aspx"/>
			<Page x:Name="OtherMailingAddr" Text="Other Mailing Address" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsAlternateAddressPresent'}"   NavigateUrl="~/Intake/ClientRegistration/AlternateAddress.aspx"/>
			<!--Completed="{n:WorkflowField Name='IndivDemo', Property='Completed', DefaultValue='false'}"-->
			<Page x:Name="IndivDemoDetailSummary" Text="Individual Demographics" SummaryScreen="True" NavigateUrl="~/Intake/ClientRegistration/IndividualDemographicsSummary.aspx"/>
			<Page x:Name="IndivDemo"
            Text="Individual Demographics"
            DetailScreen="True"
            NavigateUrl="~/Intake/ClientRegistration/IndividualDemographics.aspx"
            Context="{n:DataSource Name='dsClientRegistration_Persons'}"/>
			<Page x:Name="StateWideClearance" Text="Statewide Clearance" Visible="false" NavigateUrl="~/Intake/ClientRegistration/StateWideClearance.aspx"/>
			<Page x:Name="IndvClearance" Text="Individual Clearance" Visible="false" NavigateUrl="~/Intake/ClientRegistration/IndividualClearanceResults.aspx"/>
			<Page x:Name="MatchedDemoDetailSummary" Visible="false"  SummaryScreen="True"  Text="Matched Individual Demographics" NavigateUrl="~/Intake/ClientRegistration/MatchedIndividualSummary.aspx"/>
			<Page x:Name="MatchedIndivDemoDetails" Visible="false"  DetailScreen="True" Text="Matched Individual Details" NavigateUrl="~/Intake/ClientRegistration/MatchedIndividualDemographicsDetails.aspx"/>
			<Page x:Name="EstablishIndv" Visible="false" Text="Establish Individual"  NavigateUrl="~/Intake/ClientRegistration/EstablishIndividual.aspx"/>
			<Page x:Name="EstablishIndvReview" Visible="false" Text="Establish Individual Review"  NavigateUrl="~/Intake/ClientRegistration/EstablishIndividualReview.aspx"/>
			<Page x:Name="FinalClearanceStatus" Visible="false" Text="Final Clearance Status" NavigateUrl="~/Intake/ClientRegistration/FinalClearanceStatus.aspx"/>
			<Page x:Name="RelateCase" Text="Relate Case" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsAnyIndividualLinked'}" NavigateUrl="~/Intake/ClientRegistration/RelateCase.aspx"/>
			<Page x:Name="PriorContactSummary" Text="Prior Contact" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsAnyIndividualLinked'}" SummaryScreen="True" NavigateUrl="~/Intake/ClientRegistration/PriorContactSummary.aspx"/>
			<Page x:Name="PriorContactDetail" Visible="false" Text="Prior Contact Details" DetailScreen="True" NavigateUrl="~/Intake/ClientRegistration/PriorContact.aspx"/>
			<Page x:Name="ExpSrvDetermn" Text="Expedited Services Determination" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsFoodBenefitsPresent'}" NavigateUrl="~/Intake/ClientRegistration/ExpeditedServicesDetermination.aspx"/>
			<Page x:Name="VoterRegSummary" Text="Voter Registration" SummaryScreen="True" NavigateUrl="~/Intake/ClientRegistration/VoterRegistrationSummary.aspx"/>
			<Page x:Name="VoterRegDetail" Text="Voter Registration Details" DetailScreen="True" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsVoterRegistrationScheduled'}" NavigateUrl="~/Intake/ClientRegistration/VoterRegistration.aspx"/>
			<Page x:Name="WorkerAssignment" Text="Worker Assignment" NavigateUrl="~/Intake/ClientRegistration/WorkerAssignment.aspx"/>
			<Page x:Name="RefugeeETRefSummary" Text="Refugee Pre-Eligibility E&amp;T Referral" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ClientRegistration.ClientRegistrationDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsRefugeeServicesPresent'}"
            SummaryScreen="True" NavigateUrl="~/Intake/ClientRegistration/RefugeePreEligibilityEmploymentTrainingReferralSummary.aspx"/>
			<Page x:Name="RefugeeETRefDetail" Visible="false" DetailScreen="True" Text="Refugee Pre-Eligibility E&amp;T Referral Details" NavigateUrl="~/Intake/ClientRegistration/RefugeePreEligibilityEmploymentTrainingReferral.aspx"/>
			<Page x:Name="PrintClientForm" Text="Print RFA" SummaryScreen="True" NavigateUrl="~/Intake/ClientRegistration/PrintClientApplicationForm.aspx"/>
			<Page x:Name="CRCompletion" Visible="false" Text="CR Completion" NavigateUrl="~/Intake/ClientRegistration/CRCompletionwindow.aspx"/>

		</WorkflowRules>
	</WorkflowRules>

	<WorkflowRules x:Name="ApplicationEntryTop" Text="Application Entry">

		<WorkflowRules x:Name="ApplicationEntry" Text="Initiate Interview" Context="{n:DataSource Name='dsInitiateInterview_Case'}">
			<WorkflowRules.DataSources>

				<dhss:DataServiceLinqDataSource
        x:Key="dsInitiateInterview_Case"
        TableName="InitiateInterview_Application"
        EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ApplicationEntry.InitiateInterview.InitiateInterview_Case"
        ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.InitiateInterviewContextImpl"
        Selecting="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='InitiateApplication_Selecting'}">
				</dhss:DataServiceLinqDataSource>
				<dhss:DataServiceLinqDataSource
         x:Key="dsInitiateInterview_CaseHouseholdApplication"
   TableName="InitiateInterview_Application"
   EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ApplicationEntry.InitiateInterview.InitiateInterview_Case"
   ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.InitiateInterviewContextImpl"
   Selecting="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='InitiateCaseHouseholdEntity_Selecting'}">
				</dhss:DataServiceLinqDataSource>
				<dhss:DataServiceLinqDataSource
          x:Key="dsInitiateInterview_NotEstablishedPersons"
    TableName="InitiateInterview_Entity"
    EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ApplicationEntry.InitiateInterview.InitiateInterview_Person"
    ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.InitiateInterviewContextImpl"
    Selecting="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='InitiateNotEstablishedEntity_Selecting'}">
				</dhss:DataServiceLinqDataSource>
				<dhss:DataServiceLinqDataSource
            x:Key="dsInitiateInterview_EstablishedPersons"
      TableName="InitiateInterview_Entity"
      EntityTypeName="Dhss.Assist.WorkerWeb.Entity.ApplicationEntry.InitiateInterview.InitiateInterview_Person"
      ContextTypeName="Dhss.Assist.WorkerWeb.Web.Infrastructure.Services.InitiateInterviewContextImpl"
      Selecting="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='InitiateEstablishedEntity_Selecting'}">
				</dhss:DataServiceLinqDataSource>
			</WorkflowRules.DataSources>
			<Page x:Name="InitiateIntrwOptionsAE" Text="Initiate Interview Options" Enabled="True" NavigateUrl="~/Intake/ApplicationEntry/Initiate/InitiateInterviewOptions.aspx"
            Visible ="True"/>
			<Page x:Name="CasehouseholdInfoSummaryAE" Text="Case Household" NavigateUrl="~/Intake/ApplicationEntry/Initiate/CasehouseholdInformationSummary.aspx" SummaryScreen="True"/>
			<Page x:Name="CasehouseholdInfoAE" Visible="false" Text="Case Household" NavigateUrl="~/Intake/ApplicationEntry/Initiate/CasehouseholdInformation.aspx" DetailScreen="True"  Context="{n:DataSource Name='dsInitiateInterview_CaseHouseholdApplication'}"/>
			<Page x:Name="ApplicantsAltAddressSummaryAE" Text="Other Mailing Address" SummaryScreen="True" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsAlternateAddressPresent'}" NavigateUrl="~/Intake/ApplicationEntry/Initiate/ApplicantsAlternateAddressSummary.aspx"/>
			<Page x:Name="ApplicantsAltAddressAE" Text="Other Mailing Address Details" DetailScreen="True" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsAlternateAddressPresent'}" NavigateUrl="~/Intake/ApplicationEntry/Initiate/ApplicantsAlternateAddress.aspx"/>
			<Page x:Name="IndvDemoSummaryAE" Text="Individual Demographics" SummaryScreen="True" NavigateUrl="~/Intake/ApplicationEntry/Initiate/IndividualDemographicsSummary.aspx"/>
			<Page x:Name="IndvDemoAE" Visible="false"
            Text="Individual Demographics Established Details" DetailScreen="True" NavigateUrl="~/Intake/ApplicationEntry/Initiate/IndividualDemographics.aspx" Context="{n:DataSource Name='dsInitiateInterview_EstablishedPersons'}"/>
			<Page x:Name="IndvDemoNotEstablishedAE" Visible="{n:Method Type='Dhss.Assist.WorkerWeb.Web.Intake.ApplicationEntry.Initiate.ApplicationEntryDataServiceLinqDataSource, Dhss.Assist.WorkerWeb.Web', Name='IsNotEstablishedHasData'}"
            Text="Individual Demographics Not Established Details" DetailScreen="True" NavigateUrl="~/Intake/ApplicationEntry/Initiate/IndividualDemographicsNotestablished.aspx" Context="{n:DataSource Name='dsInitiateInterview_NotEstablishedPersons'}"/>
			<Page x:Name="StateWideClearanceAE" Text="Statewide Clearance" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/StateWideClearance.aspx"/>
			<Page x:Name="IndvClearanceAE" Text="Individual Clearance" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/IndividualClearanceResults.aspx"/>
			<Page x:Name="MatchedDemoDetailSummaryAE" Text="Matched Individual Demographics" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/MatchedIndividualSummary.aspx"/>
			<Page x:Name="MatchedIndivDemoDetailsAE" Text="Matched Individual Details Details" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/MatchedIndividualDemographicsDetails.aspx"/>
			<Page x:Name="EstablishIndvAE" Text="Establish Individual" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/EstablishIndividual.aspx"/>
			<Page x:Name="EstablishIndvReviewAE" Text="Establish Individual" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/EstablishIndividualReview.aspx"/>
			<Page x:Name="FinalClearanceStatusAE" Text="Final Clearance" Visible="false" NavigateUrl="~/Intake/ApplicationEntry/Initiate/FinalClearanceStatus.aspx"/>

		</WorkflowRules>
